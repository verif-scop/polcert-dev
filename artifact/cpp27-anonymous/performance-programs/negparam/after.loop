context(n);

for i0 in range(((-1 * n) + 4), (n + 3)) {
  for i1 in range(((-1 * n) + 4), ((-1 * n) + 5)) {
    for i2 in range(((-1 * n) + 4), ((-1 * n) + 5)) {
      a[i2][i0] = (a[(i2 + -1)][i0] + 2);
    }
  }
  for i1 in range(((-1 * n) + 5), (n + 3)) {
    a[i1][i0] = (a[(i1 + -1)][i0] + 2);
    for i2 in range((i1 + -1), i1) {
      a[i2][i0] = (a[i2][i0] + 1);
    }
  }
  for i1 in range((n + 3), (n + 4)) {
    for i2 in range((n + 2), (n + 3)) {
      a[i2][i0] = (a[i2][i0] + 1);
    }
  }
}
