          pathDistanceMatrix[i3][i4] = (((pathDistanceMatrix[i3][i0] + pathDistanceMatrix[i0][i4]) <= (pathDistanceMatrix[i3][i4] - 1)) ? (pathDistanceMatrix[i3][i0] + pathDistanceMatrix[i0][i4]) : pathDistanceMatrix[i3][i4]);
        }
