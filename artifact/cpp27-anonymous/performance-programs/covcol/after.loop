context(M, N);

if ((1 <= N && 1 <= M)) {
  for i0 in range(1, (N + 1)) {
    for i1 in range(1, (M + 1)) {
      for i2 in range(i1, (M + 1)) {
        symmat[i1][i2] = (symmat[i1][i2] + (data[i0][i1] * data[i0][i2]));
      }
    }
  }
}
if (1 <= M) {
  for i0 in range(1, (M + 1)) {
    for i1 in range(i0, (M + 1)) {
      symmat[i1][i0] = symmat[i0][i1];
    }
  }
}
