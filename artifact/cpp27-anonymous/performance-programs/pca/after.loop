context(m, n);

if (2 <= m) {
  for i0 in range(0, ((m + 31) / 32)) {
    for i1 in range(max((((32 * i0) + 1) / 32), 0), ((m + 32) / 32)) {
      for i2 in range(max((32 * i0), 1), min(min(((32 * i1) + 31), m), ((32 * i0) + 32))) {
        for i3 in range(max((32 * i1), (i2 + 1)), min(((32 * i1) + 32), (m + 1))) {
          symmat[i2][i3] = 0.0;
        }
      }
    }
  }
}
if (2 <= m) {
  for i0 in range(0, ((m + 31) / 32)) {
    for i1 in range(max((32 * i0), 1), min(((32 * i0) + 32), m)) {
      symmat[i1][i1] = 1.0;
      stddev[i1] = 0.0;
      mean[i1] = 0.0;
    }
    if ((m + (-32 * i0)) <= 31) {
      stddev[m] = 0.0;
      mean[m] = 0.0;
    }
  }
  if ((m % 32) == 0) {
    stddev[(32 * (m / 32))] = 0.0;
    mean[(32 * (m / 32))] = 0.0;
  }
}
if ((m <= 1 && 1 <= m)) {
  stddev[1] = 0.0;
  mean[1] = 0.0;
}
if ((1 <= m && 1 <= n)) {
  for i0 in range(0, ((m + 32) / 32)) {
    for i1 in range(0, ((n + 32) / 32)) {
      for i2 in range(max((32 * i0), 1), min(((32 * i0) + 32), (m + 1))) {
        for i3 in range(max((32 * i1), 1), min(((32 * i1) + 32), (n + 1))) {
          mean[i2] = (mean[i2] + data[i3][i2]);
        }
      }
    }
  }
}
if (1 <= m) {
  for i0 in range(0, ((m + 32) / 32)) {
    for i1 in range(max(1, (32 * i0)), min((m + 1), ((32 * i0) + 32))) {
      mean[i1] = (mean[i1] / float_n);
    }
  }
}
if ((1 <= m && 1 <= n)) {
  for i0 in range(0, ((m + 32) / 32)) {
    for i1 in range(0, ((n + 32) / 32)) {
      for i2 in range(max((32 * i0), 1), min(((32 * i0) + 32), (m + 1))) {
        for i3 in range(max(1, (32 * i1)), min((n + 1), ((32 * i1) + 32))) {
          stddev[i2] = (stddev[i2] + ((data[i3][i2] - mean[i2]) * (data[i3][i2] - mean[i2])));
          data[i3][i2] = (data[i3][i2] - mean[i2]);
        }
      }
    }
  }
}
if (1 <= m) {
  for i0 in range(0, ((m + 32) / 32)) {
    for i1 in range(max((32 * i0), 1), min(((32 * i0) + 32), (m + 1))) {
      stddev[i1] = (stddev[i1] / float_n);
      stddev[i1] = sqrt(stddev[i1]);
      stddev[i1] = ((stddev[i1] <= eps) ? 1.0 : stddev[i1]);
    }
  }
}
if ((1 <= n && 1 <= m)) {
  for i0 in range(1, (n + 1)) {
    for i1 in range(1, (m + 1)) {
      x = sqrt(float_n);
      x = (x * stddev[i1]);
      data[i0][i1] = (data[i0][i1] / x);
    }
  }
}
if ((1 <= n && 2 <= m)) {
  for i0 in range(0, ((m + 31) / 32)) {
    for i1 in range(max((((32 * i0) + 1) / 32), 0), ((m + 32) / 32)) {
      for i2 in range(0, ((n + 32) / 32)) {
        for i3 in range(max(1, (32 * i0)), min(min(m, ((32 * i1) + 31)), ((32 * i0) + 32))) {
          for i4 in range(max((i3 + 1), (32 * i1)), min((m + 1), ((32 * i1) + 32))) {
            for i5 in range(max(1, (32 * i2)), min((n + 1), ((32 * i2) + 32))) {
              symmat[i3][i4] = (symmat[i3][i4] + (data[i5][i3] * data[i5][i4]));
            }
          }
        }
      }
    }
  }
}
if (2 <= m) {
  for i0 in range(0, ((m + 31) / 32)) {
    for i1 in range(max((((32 * i0) + 1) / 32), 0), ((m + 32) / 32)) {
      for i2 in range(max((32 * i0), 1), min(min(((32 * i1) + 31), m), ((32 * i0) + 32))) {
        for i3 in range(max((32 * i1), (i2 + 1)), min(((32 * i1) + 32), (m + 1))) {
          symmat[i3][i2] = symmat[i2][i3];
        }
      }
    }
  }
}
