# Toy OpenScop array expansion/versioning target skeleton
# Each source definition of X[i] is stored as X_exp[t][i].
<arrays>
1 X
2 X_exp
3 Y
</arrays>
<body>
# Statement S_write_version(t,i)
WRITE
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == X_exp
   0    0   -1    1    0    0    0    0    ## [1] == t
   0    0    0   -1    0    1    0    0    ## [2] == i

# Statement S_read_version_to_y(t,i)
READ
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == X_exp
   0    0   -1    1    0    0    0    0    ## [1] == t
   0    0    0   -1    0    1    0    0    ## [2] == i

WRITE
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == Y
   0    0   -1    1    0    0    0    0    ## [1] == t
   0    0    0   -1    0    1    0    0    ## [2] == i

# Statement S_final_copy(i)
READ
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == X_exp
   0    0   -1    0    1    0    0    0    ## [1] == T - 1
   0    0    0   -1    0    1    0    0    ## [2] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == X
   0    0   -1    1    0    0    ## [1] == i

</body>
