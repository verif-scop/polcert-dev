# Toy OpenScop array expansion/versioning source skeleton
# X[i] is overwritten at each t; Y[t][i] observes the current X[i].
<arrays>
1 X
2 Y
</arrays>
<body>
# Statement S_write_x(t,i)
WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == X
   0    0   -1    1    0    0    ## [1] == i

# Statement S_read_x_to_y(t,i)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == X
   0    0   -1    1    0    0    ## [1] == i

WRITE
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == Y
   0    0   -1    1    0    0    0    0    ## [1] == t
   0    0    0   -1    0    1    0    0    ## [2] == i

</body>
