# Toy OpenScop double buffering target skeleton
# Target program: next[i] = cur[i] + 1; swap(cur,next)
# cur/next phase projection is represented in the JSON witness.
<arrays>
1 Buf
</arrays>
<body>
# Statement S_step_buffered(t,i)
READ
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == Buf
   0    0   -1    0    1    0    0    0    ## [1] == cur(t)
   0    0    0   -1    0    1    0    0    ## [2] == i

WRITE
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == Buf
   0    0   -1    1    0    0    0    0    ## [1] == next(t)
   0    0    0   -1    0    1    0    0    ## [2] == i

</body>
