# Toy OpenScop overlapped tiling target skeleton
# Tiles compute halo/private duplicates; only owner commits public B[i].
<arrays>
1 A
2 B
3 B_tile
</arrays>
<body>
# Statement S_tile_compute(tile,k)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    1   -1    ## [1] == tile_base + k - 1

READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    1    0    ## [1] == tile_base + k

READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    1    1    ## [1] == tile_base + k + 1

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B_tile
   0    0   -1    0    1    0    ## [1] == k

# Statement S_tile_commit(tile,k)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B_tile
   0    0   -1    0    1    0    ## [1] == k

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B
   0    0   -1    1    1    0    ## [1] == tile_base + k

</body>
