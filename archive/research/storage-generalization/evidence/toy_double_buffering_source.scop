# Toy OpenScop double buffering source skeleton
# Logical program: A[t][i] = A[t-1][i] + 1
<arrays>
1 A
</arrays>
<body>
# Statement S_step(t,i)
READ
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == A
   0    0   -1    0    1    0    0    0    ## [1] == t - 1
   0    0    0   -1    0    1    0    0    ## [2] == i

WRITE
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == A
   0    0   -1    1    0    0    0    0    ## [1] == t
   0    0    0   -1    0    1    0    0    ## [2] == i

</body>
