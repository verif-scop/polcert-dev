# Toy OpenScop inter-array reuse target skeleton
# T1 and T2 are both represented by private Buf in disjoint phases.
<arrays>
1 A
2 B
3 C
4 D
5 Buf
</arrays>
<body>
# Phase P1
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == Buf
   0    0   -1    1    0    0    ## [1] == i

READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == Buf
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == C
   0    0   -1    1    0    0    ## [1] == i

# Phase P2; Buf is reused after T1's last consumer.
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == Buf
   0    0   -1    1    0    0    ## [1] == i

READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == Buf
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == D
   0    0   -1    1    0    0    ## [1] == i

</body>
