# Toy OpenScop scratchpad packing target skeleton
# Target program:
#   Bp[k] = B[kk + k]
#   C[kk + k] = A[kk + k] + Bp[k]
<arrays>
1 A
2 B
3 C
4 Bp
</arrays>
<body>
# Statement S_copy_in(kk,k)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B
   0    0   -1    1    1    0    ## [1] == kk + k

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == Bp
   0    0   -1    0    1    0    ## [1] == k

# Statement S_compute_local(kk,k)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    1    0    ## [1] == kk + k

READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == Bp
   0    0   -1    0    1    0    ## [1] == k

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == C
   0    0   -1    1    1    0    ## [1] == kk + k

</body>
