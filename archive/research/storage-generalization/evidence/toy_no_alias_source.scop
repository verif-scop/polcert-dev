# Toy OpenScop source no-alias abstraction skeleton
# A[i] = B[i] + 1 under distinct logical variable footprints.
<arrays>
1 A
2 B
</arrays>
<body>
# Statement S(i)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    0    0    ## [1] == i

</body>
