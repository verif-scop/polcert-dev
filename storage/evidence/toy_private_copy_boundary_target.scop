# Toy OpenScop private copy-boundary target skeleton
# local[i] = A[i]; local[i] = local[i] + 1; B[i] = local[i]
<arrays>
1 A
2 B
3 local
</arrays>
<body>
# Statement S_copy_in(i)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == local
   0    0   -1    1    0    0    ## [1] == i

# Statement S_private_compute(i)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == local
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == local
   0    0   -1    1    0    0    ## [1] == i

# Statement S_copy_out(i)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == local
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B
   0    0   -1    1    0    0    ## [1] == i

</body>
