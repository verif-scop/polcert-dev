# Toy OpenScop contextual frame target skeleton
# tmp is private; B is updated; protected frame C is not written.
<arrays>
1 A
2 B
3 C
4 tmp
</arrays>
<body>
# Statement S_private_compute(i)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == tmp
   0    0   -1    1    0    0    ## [1] == i

# Statement S_commit(i)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == tmp
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B
   0    0   -1    1    0    0    ## [1] == i

# Frame C has no target WRITE relation.
</body>
