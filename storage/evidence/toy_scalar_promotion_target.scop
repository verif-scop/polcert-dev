# Toy OpenScop scalar promotion target skeleton
# s = A[i]; s = s + 1; A[i] = s; B[i] = s * 2
<arrays>
1 A
2 B
3 s
</arrays>
<body>
# Statement S_load(i)
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    0    0    ## [1] == i

WRITE
1 4 1 1 0 1
# e/i| Arr | iterator | 1
   0   -1    0    0    ## Arr == s

# Statement S_update_scalar(i)
READ
1 4 1 1 0 1
# e/i| Arr | iterator | 1
   0   -1    0    0    ## Arr == s

WRITE
1 4 1 1 0 1
# e/i| Arr | iterator | 1
   0   -1    0    0    ## Arr == s

# Statement S_store_back(i)
READ
1 4 1 1 0 1
# e/i| Arr | iterator | 1
   0   -1    0    0    ## Arr == s

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    0    0    ## [1] == i

# Statement S_use_scalar(i)
READ
1 4 1 1 0 1
# e/i| Arr | iterator | 1
   0   -1    0    0    ## Arr == s

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B
   0    0   -1    1    0    0    ## [1] == i

</body>
