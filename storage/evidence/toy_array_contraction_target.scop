# Toy OpenScop array contraction target skeleton
# Target program: A2[t mod 2][i] = A2[(t-1) mod 2][i] + 1
# The modulo/phase projection is represented in the JSON witness.
<arrays>
1 A2
</arrays>
<body>
# Statement S_update_folded(t,i)
READ
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == A2
   0    0   -1    0    1    0    0    0    ## [1] == (t - 1) mod 2
   0    0    0   -1    0    1    0    0    ## [2] == i

WRITE
3 8 3 2 0 1
# e/i| Arr [1] [2]| t i | 1
   0   -1    0    0    0    0    0    0    ## Arr == A2
   0    0   -1    1    0    0    0    0    ## [1] == t mod 2
   0    0    0   -1    0    1    0    0    ## [2] == i

</body>
