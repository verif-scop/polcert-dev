# Toy OpenScop index-set splitting source skeleton
# One source statement has two guarded expressions.
<arrays>
1 A
2 B
</arrays>
<body>
# Statement S(i), domain 0 <= i < N
READ
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == A
   0    0   -1    1    0    0    ## [1] == i

WRITE
2 6 2 1 0 1
# e/i| Arr [1]| iterator | 1
   0   -1    0    0    0    0    ## Arr == B
   0    0   -1    1    0    0    ## [1] == i

</body>
